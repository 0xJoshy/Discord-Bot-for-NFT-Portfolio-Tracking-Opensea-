# Discord bot token — from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# OpenSea API key — request one at https://docs.opensea.io/reference/api-keys
OPENSEA_API_KEY=your_opensea_api_key_here

# Optional: a default wallet so /portfolio works with no argument
WALLET_ADDRESS=0xYourWalletAddressHere

# Optional: comma-separated chain slugs to check by default.
# OpenSea has no single "all chains" call, so the bot queries each one listed
# here and merges the results. Full list: GET https://api.opensea.io/api/v2/chains
CHAINS=ethereum,polygon,base,arbitrum,optimism,robinhood
